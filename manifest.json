{
  "manifest_version": 3,
  "name": "Practicum Theory to New Editor",
  "short_name": "Practicum Theory to New Editor",
  "version": "3.5.4",
  "description": "Render-aware copier from Yonote and Wiki to Praktikum theory",
  "icons": {
    "16": "icon128.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://yonote.ru/*",
    "https://*.yonote.ru/*",
    "https://wiki.yandex-team.ru/*",
    "https://*.wiki.yandex-team.ru/*",
    "https://s3.mds.yandex.net/*",
    "https://storage.yandexcloud.net/*",
    "https://*.storage.yandexcloud.net/*",
    "https://admin.praktikum.yandex-team.ru/*",
    "https://*.admin.praktikum.yandex-team.ru/*",
    "https://admin-prestable.practicum.yandex-team.ru/*"
  ],
  "content_scripts": [
